"""
Task-03: Password Complexity Checker
--------------------------------------
Assesses the strength of a password based on:
  - Length
  - Presence of uppercase letters
  - Presence of lowercase letters
  - Presence of numbers
  - Presence of special characters

Gives the user feedback on the password's strength and specific
suggestions for improving it.
"""

import re
import getpass


def check_password_strength(password: str) -> dict:
    """
    Evaluate a password against several complexity criteria.
    Returns a dict with the score, max score, strength label,
    and a list of feedback messages.
    """
    criteria = {
        "length_8": len(password) >= 8,
        "length_12": len(password) >= 12,
        "uppercase": bool(re.search(r"[A-Z]", password)),
        "lowercase": bool(re.search(r"[a-z]", password)),
        "digit": bool(re.search(r"[0-9]", password)),
        "special": bool(re.search(r"[!@#$%^&*(),.?\":{}|<>_\-+=\[\];'~`\\/]", password)),
    }

    score = sum(criteria.values())
    max_score = len(criteria)

    feedback = []
    if not criteria["length_8"]:
        feedback.append("Make the password at least 8 characters long.")
    elif not criteria["length_12"]:
        feedback.append("Consider using 12+ characters for stronger security.")
    if not criteria["uppercase"]:
        feedback.append("Add at least one uppercase letter (A-Z).")
    if not criteria["lowercase"]:
        feedback.append("Add at least one lowercase letter (a-z).")
    if not criteria["digit"]:
        feedback.append("Add at least one number (0-9).")
    if not criteria["special"]:
        feedback.append("Add at least one special character (e.g. ! @ # $ %).")

    if len(password) == 0:
        strength = "No password entered"
    elif score <= 2:
        strength = "Weak"
    elif score <= 4:
        strength = "Moderate"
    elif score <= 5:
        strength = "Strong"
    else:
        strength = "Very Strong"

    if not feedback:
        feedback.append("Great job! This password meets all the criteria checked.")

    return {
        "score": score,
        "max_score": max_score,
        "strength": strength,
        "feedback": feedback,
        "criteria": criteria,
    }


def print_report(password: str):
    result = check_password_strength(password)

    print("\n" + "-" * 50)
    print(f"Password Strength : {result['strength']}")
    print(f"Score              : {result['score']} / {result['max_score']}")
    print("-" * 50)

    print("Criteria met:")
    labels = {
        "length_8": "At least 8 characters",
        "length_12": "At least 12 characters",
        "uppercase": "Contains uppercase letter",
        "lowercase": "Contains lowercase letter",
        "digit": "Contains number",
        "special": "Contains special character",
    }
    for key, met in result["criteria"].items():
        mark = "✔" if met else "✘"
        print(f"  [{mark}] {labels[key]}")

    print("\nFeedback:")
    for tip in result["feedback"]:
        print(f"  - {tip}")
    print("-" * 50)


def main():
    print("=" * 50)
    print("      PASSWORD COMPLEXITY CHECKER")
    print("=" * 50)

    while True:
        print("\nChoose an option:")
        print("  1. Check a password")
        print("  2. Exit")
        choice = input("Enter choice (1/2): ").strip()

        if choice == '1':
            try:
                # Hides input where the terminal supports it; falls back
                # to plain input() if getpass isn't supported.
                password = getpass.getpass("Enter password to check (hidden): ")
            except Exception:
                password = input("Enter password to check: ")
            print_report(password)

        elif choice == '2':
            print("Exiting program. Goodbye!")
            break

        else:
            print("Invalid choice. Please enter 1 or 2.")


if __name__ == "__main__":
    main()
