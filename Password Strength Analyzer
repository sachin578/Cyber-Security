import secrets
import string
import math
import re
import time

class PasswordSecurityTool:
    def __init__(self):
        # A mock database of commonly hacked/weak passwords to demonstrate reuse prevention
        self.common_passwords_db = {
            "password", "123456", "12345678", "qwerty", "abc123", 
            "monkey", "1234567", "letmein", "trustno1", "dragon", 
            "baseball", "iloveyou", "master", "sunshine", "ashley"
        }

    def calculate_entropy(self, password):
        """
        Estimates entropy (randomness) in bits.
        Formula: Length * log2(Size of Character Pool)
        """
        pool_size = 0
        if any(c.islower() for c in password): pool_size += 26
        if any(c.isupper() for c in password): pool_size += 26
        if any(c.isdigit() for c in password): pool_size += 10
        if any(c in string.punctuation for c in password): pool_size += 32
        
        if pool_size == 0:
            return 0
        
        entropy = len(password) * math.log2(pool_size)
        return int(entropy)

    def evaluate_strength(self, password):
        feedback = []
        score = 0
        
        # 1. Database Reuse Check (Optional)
        if password.lower() in self.common_passwords_db:
            feedback.append("❌ CRITICAL: This password is on a known 'breached' list. Do not use.")
            score -= 10
        else:
            feedback.append("✅ Password is not in the known breached database.")
            score += 1

        # 2. Length Check
        if len(password) < 8:
            feedback.append("❌ Too short: Password is under 8 characters.")
        elif len(password) >= 12:
            feedback.append("✅ Excellent length ( >= 12 chars).")
            score += 2
        else:
            feedback.append("✅ Good length (8-11 chars).")
            score += 1

        # 3. Complexity Checks
        has_upper = bool(re.search(r"[A-Z]", password))
        has_lower = bool(re.search(r"[a-z]", password))
        has_digit = bool(re.search(r"[0-9]", password))
        has_special = bool(re.search(r"[!@#$%^&*(),.?\":{}|<>]", password))

        if has_upper: score += 1
        else: feedback.append("⚠️ Missing uppercase letters.")

        if has_lower: score += 1
        else: feedback.append("⚠️ Missing lowercase letters.")

        if has_digit: score += 1
        else: feedback.append("⚠️ Missing numbers.")

        if has_special: score += 1
        else: feedback.append("⚠️ Missing special characters/symbols.")

        # 4. Uniqueness/Entropy Calculation
        entropy = self.calculate_entropy(password)
        feedback.append(f"Calculated Entropy: {entropy} bits (Higher is better).")

        # Determine Rating
        rating = "WEAK"
        if score >= 6 and entropy > 60:
            rating = "MODERATE"
        if score >= 7 and entropy > 80:
            rating = "STRONG"

        return rating, score, feedback

    def generate_strong_alternative(self, length=16):
        """
        Generates a cryptographically strong random password.
        """
        alphabet = string.ascii_letters + string.digits + string.punctuation
        # secrets.choice is preferred over random for security
        password = ''.join(secrets.choice(alphabet) for _ in range(length))
        return password

# --- INTERFACE ---
def main():
    tool = PasswordSecurityTool()
    
    print("--- Password Strength Evaluator ---")
    print("Note: For educational purposes only. Do not enter your real banking passwords here.")
    
    while True:
        print("\n" + "="*30)
        user_pass = input("Enter a password to check (or 'q' to quit): ")
        
        if user_pass.lower() == 'q':
            break
        
        # Fake delay to simulate checking
        print("Analyzing...", end="\r")
        time.sleep(0.5)
        
        rating, score, feedback = tool.evaluate_strength(user_pass)
        
        print(f"\n[Result] Strength: {rating}")
        print("-" * 20)
        for item in feedback:
            print(item)
            
        if rating != "STRONG":
            print("\n[Suggestion] Here is a generated alternative:")
            new_pass = tool.generate_strong_alternative()
            print(f"> {new_pass}")
            print("(Save this if you like it!)")

if __name__ == "__main__":
    main()
